# TG Gateway - variables de entorno
# ---------------------------------
# Copia este archivo a `.env` y completa los valores para el deploy.
# Las vars no listadas usan los defaults documentados en el README.
#
# Este `.env` es también el que leen, por defecto, el servidor MCP
# (dist/tg-mcp.mjs) y el helper tg-send.mjs: lo buscan junto a la instalación
# (../.env desde dist/), no en el directorio de trabajo. Si el fichero está en
# otro sitio, define TG_GATEWAY_ENV_FILE.

# === Core Telegram ===
# Token del bot de Telegram. OBLIGATORIO.
TG_BOT_TOKEN=

# Chats permitidos (separados por coma). El gateway es cerrado por defecto:
# vacio o sin definir = NO se acepta ningun update.
TG_ALLOWED_CHATS=

# Long polling de Telegram (segundos). Default 30.
TG_POLL_TIMEOUT=30

# Intervalo minimo entre mensajes salientes (ms). Default 1200.
TG_MIN_INTERVAL_MS=1200

# === API interna ===
# Puerto de la API HTTP interna. Default 4000.
PORT=4000

# Log de la aplicación (JSON por línea). Si no se define, solo stdout.
# TG_LOG_FILE=/var/log/tg-gateway.log

# === Logging ===
# Nivel de log: debug, info, warn, error. Default info.
LOG_LEVEL=info

# Texto/caption en logs, recortado a este número de caracteres. Default 200; 0 desactiva.
TG_LOG_TEXT_CHARS=200

# === Handlers por defecto ===
# Formato: comando=webhook, separados por coma.
# Ejemplo: TG_DEFAULT_HANDLERS=/f2b=http://localhost:4000/tg-incoming

# === Timeouts ===
# Timeout del webhook para handlers externos (ms). Default 10000 (10 s).
TG_TIMEOUT_FORWARD_MS=10000

# Timeouts por metodo de la API de Telegram (salientes). Las llamadas JSON son
# rapidas (default 15 s). Los multipart (foto/video) viajan archivos enteros,
# asi que tienen default 60 s. Pisa estos valores si tu red es mas lenta.
# TG_TIMEOUT_SEND_MESSAGE_MS=15000
# TG_TIMEOUT_SEND_PHOTO_MS=60000
# TG_TIMEOUT_SEND_VIDEO_MS=60000
# TG_TIMEOUT_EDIT_REPLY_MARKUP_MS=15000
# TG_TIMEOUT_DELETE_MESSAGE_MS=15000
# TG_TIMEOUT_ANSWER_CALLBACK_QUERY_MS=15000
# TG_TIMEOUT_GET_ME_MS=15000

# === Retry ===
# Reintentos ante errores de red transitorios al forward() de webhooks.
# Default 0 (no retry, seguro porque los receptores pueden no ser idempotentes).
# Subilo a 1-3 solo si sabes que tus webhooks toleran reentregas.
TG_FORWARD_RETRIES=0

# === Circuit breaker para salidas hacia Telegram ===
# N llamadas consecutivas que fallen por red antes de que el breaker se abra.
# Default 5.
TG_CIRCUIT_BREAKER_THRESHOLD=5

# Cooldown del circuit breaker en milisegundos. Default 30000.
TG_CIRCUIT_BREAKER_COOLDOWN_MS=30000

# Caducidad de la llamada de prueba en half-open (ms). Default 20000.
# Si una prueba se queda colgada, pasado este plazo otra llamada puede
# relevarla: sin esto el breaker podía quedarse en half-open para siempre
# (incidente del 30-sep-2026: 8 horas sin poder entregar nada).
TG_CIRCUIT_BREAKER_HALF_OPEN_MS=20000

# Cada cuánto sondea el vigilante con getMe mientras el breaker no está
# cerrado (ms). 0 lo desactiva. Default 30000.
TG_CIRCUIT_WATCHDOG_MS=30000

# === Deprecated ===
# TG_HANDLER_TIMEOUT_MS ya no se lee. Su reemplazo es TG_TIMEOUT_FORWARD_MS.
# Si tu .env todavia tiene esta variable, se ignora silenciosamente.
# TG_HANDLER_TIMEOUT_MS=10000
